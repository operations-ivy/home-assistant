#!/bin/sh
# The setup after onboarding and pairing (README, "First setup"), from the
# laptop. Needs an administrator's long-lived token in $HA_SETUP_TOKEN_FILE
# (default ~/.config/home-assistant/setup-token, mode 600); it goes to the pod
# on stdin and is never printed. Safe to run again: each step skips what's
# done.
#
#   1. Trusted proxies (the pod network and every node's address, read from
#      the cluster; run this again after a node joins or leaves): stage them,
#      let HA restart, check the site through Caddy, and only then confirm
#      them (otherwise HA reverts in 5 minutes).
#   2. The ecobee's climate entity becomes climate.thermostat.
#   3. Panel, Monitoring, Board and Presto users, and their tokens: Panel's into
#      brick1982's ~/.config/lcars/env, Board's into brick9000's
#      ~/.config/brick-status/env, Monitoring's sealed into brick-k8s-secrets
#      and applied for the PodMonitor, Presto's kept on the laptop
#      (~/.config/home-assistant/presto-token) for the Presto's secrets.py.
#      None is ever printed.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
token_file=${HA_SETUP_TOKEN_FILE:-$HOME/.config/home-assistant/setup-token}
site=https://homeassistant.brick.nozdormu.cloud
secrets_repo=${BRICK_K8S_SECRETS:-$HOME/code/brick-k8s-secrets}
cert=${SEALED_SECRETS_CERT:-$HOME/code/brick-k8s-config/secrets/sealed-secrets-public-cert.pem}  # secret-scan: allow (a path default, not a credential; user confirmed)

[ -s "$token_file" ] || { echo "setup: no token in $token_file" >&2; exit 1; }

step() {
    kubectl -n home-assistant exec -i deploy/home-assistant -- \
        python3 -c "$(cat "$here/setup_ha.py")" "$@" < "$token_file"
}

# k3s's pod network, then each node's address (one per line).
proxies=$(kubectl get nodes -o jsonpath='{range .items[*]}{.status.addresses[?(@.type=="InternalIP")].address}/32{"\n"}{end}')
[ -n "$proxies" ] || { echo "setup: can't read the nodes' addresses" >&2; exit 1; }

wait_up() {
    for _ in $(seq 60); do
        code=$(curl -s -o /dev/null -w '%{http_code}' -m 5 "$1" || true)
        case $code in 200|302) return 0;; esac
        sleep 5
    done
    return 1
}

if step http-configure 10.42.0.0/16 $proxies | grep -q '"restart": true'; then
    sleep 10
    if ! wait_up "$site/"; then
        echo "setup: $site doesn't answer with the new proxies; HA reverts them in 5 minutes" >&2
        exit 1
    fi
fi
step http-promote

step entities

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
step users > "$tmp/tokens.json"
python3 - "$tmp" <<'EOF'
import json, os, sys
tmp = sys.argv[1]
for name, token in json.load(open(os.path.join(tmp, "tokens.json"))).items():
    path = os.path.join(tmp, name)
    with open(os.open(path, os.O_WRONLY | os.O_CREAT, 0o600), "w") as f:
        f.write(token)
EOF

# put_token USER HOST DIR VAR: replace VAR's line in HOST's DIR/env with
# USER's token, or add one. The token goes over ssh's stdin, never argv.
put_token() {
    { printf '%s=' "$4"; cat "$tmp/$1"; echo; } | ssh "$2" "
        umask 077; mkdir -p ~/$3; f=~/$3/env; touch \"\$f\"
        line=\$(cat); grep -v '^$4=' \"\$f\" > \"\$f.new\" || true
        echo \"\$line\" >> \"\$f.new\"; mv \"\$f.new\" \"\$f\""
    echo "setup: $1's token is in $2's ~/$3/env"
}

if [ -f "$tmp/Panel" ]; then
    put_token Panel brick1982 .config/lcars HA_TOKEN
fi

if [ -f "$tmp/Presto" ]; then
    # The Presto is MicroPython with no ssh: its token waits on the laptop for
    # its secrets.py (HA_TOKEN = "..."), copied over USB (presto README).
    keep=${PRESTO_TOKEN_FILE:-$HOME/.config/home-assistant/presto-token}
    (umask 077; mkdir -p "$(dirname "$keep")"; cp "$tmp/Presto" "$keep")
    echo "setup: Presto's token is in $keep; put it in the Presto's secrets.py as HA_TOKEN"
fi

if [ -f "$tmp/Board" ]; then
    # brick-status reads it at start: restart it there to pick it up.
    put_token Board brick9000 .config/brick-status BRICK_STATUS_HA_TOKEN
    ssh brick9000 'systemctl --user restart brick-status' || true
fi

if [ -f "$tmp/Monitoring" ]; then
    mkdir -p "$secrets_repo/home-assistant"
    sealed="$secrets_repo/home-assistant/home-assistant-prometheus-sealedsecret.yaml"
    kubectl create secret generic home-assistant-prometheus --namespace home-assistant \
        --dry-run=client --from-file=token="$tmp/Monitoring" -o yaml |
        kubeseal --cert "$cert" --format yaml > "$sealed"
    kubectl apply -f "$sealed"
    echo "setup: Monitoring's token is sealed in $sealed (commit it there)"
fi
